# Copy to .env. Never commit .env.
PORT=8080
APP_ENV=development # development, test, production

# Prod DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_api_auth?sslmode=disable

# Tests use Postgres too. Defaults to DATABASE_URL when empty; each test
# package creates and drops its own throwaway database.
TEST_DATABASE_URL=

# Auth
JWT_SECRET=change-me-to-32-bytes-minimum
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_RESET_TTL_MIN=30
BCRYPT_COST=12

# Public base URL used to build password-reset links
APP_BASE_URL=http://localhost:8080

# Comma-separated allowed browser origins (empty disables CORS)
CORS_ORIGINS=

# Mail (forgot-password / verify-email)
MAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Rate limit
RATE_LIMIT_PER_MIN=60

# Database connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

