# Copy to .env. Never commit .env.
PORT=8080
APP_ENV=development # development, test, production

# Prod DB. Tests use sqlite memory, so this stays empty in test.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_api_auth?sslmode=disable

# Auth
JWT_SECRET=change-me-to-32-bytes-minimum
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# Mail (forgot-password / verify-email)
MAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Rate limit
RATE_LIMIT_PER_MIN=60
